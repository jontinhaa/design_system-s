9:["$","p",null,{"children":"We do not knowingly collect data from children, and we do not process special categories of personal data (Article 9 GDPR). Please do not send us any. We do not make decisions about you by automated means that produce legal effects or similarly significantly affect you."}]
a:["$","h2",null,{"children":"4. Cookies and analytics"}]
b:["$","p",null,{"children":["With your consent we use ",["$","strong",null,{"children":"Google Analytics 4"}]," to see how people find the site and which pages they read. It does not load, and sets no cookies, until you allow analytics on the cookie bar. We have switched off Google signals and ad personalisation, we remove your name and e-mail from page addresses before anything is sent, and Google does not store IP addresses for EU visitors. We use the results only in aggregate; we do not try to identify individual visitors and we run no advertising pixels or retargeting."]}]
c:["$","p",null,{"children":["The booking calendar on our contacts page is hosted by Cal.com, and we do not load it until you say yes to it separately. Details, including every cookie and how long it lasts, are in our ",["$","$L2e",null,{"href":"/cookies","children":"Cookie Policy"}],"."]}]
d:["$","h2",null,{"children":"5. Who we share your data with"}]
e:["$","p",null,{"children":"We do not sell personal data and we do not share it for other organisations marketing purposes."}]
f:["$","p",null,{"children":"We use service providers who process personal data on our instructions (processors): e-mail and file storage, calendar booking, e-signature, project management, design tools, website hosting and CMS, website analytics (Google Analytics, provided by Google Ireland Limited), e-mail delivery, and AI-assisted tools used on business plans that do not use our inputs to train models. Each is bound by a data processing agreement and may use your data only to provide the service to us. The current list of our processors and sub-processors is available on request."}]
10:["$","p",null,{"children":"We may also disclose data to our accountant, legal advisers, banks and payment providers, and to public authorities where the law requires it. Contractors who work on a project are bound by written confidentiality and data protection obligations at least as strict as those we owe you."}]
11:["$","h2",null,{"children":"6. Transfers outside the European Economic Area"}]
12:["$","p",null,{"children":"Some of our providers are established in the United States or process data there. Where personal data is transferred outside the EEA, we rely on the European Commission adequacy decision for the EUâ€“U.S. Data Privacy Framework where the provider is certified under it; or on Standard Contractual Clauses with additional safeguards where an assessment shows they are needed; or on another mechanism permitted under Chapter V GDPR. Ask us for a copy of the relevant safeguards at any time."}]
13:["$","h2",null,{"children":"7. How long we keep it"}]
14:["$","div",null,{"className":"LegalPage-module__QUED1W__tableWrap","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Data"}],["$","th",null,{"children":"Retention"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Enquiries that do not lead to a project"}],["$","td",null,{"children":"12 months from the last message, then deleted"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Prospect and outreach records"}],["$","td",null,{"children":"Until you object, or 24 months without contact"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Client project files and correspondence"}],["$","td",null,{"children":"The engagement plus 6 years, to evidence what was delivered and to bring or defend claims"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Contracts, IP assignments and signature records"}],["$","td",null,{"children":"The engagement plus 6 years; copyright transfer documents for as long as the rights are exercised"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Invoices, accounting and tax records"}],["$","td",null,{"children":"5 years from the end of the calendar year in which the tax became payable, as Polish tax law requires"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Booking records"}],["$","td",null,{"children":"12 months"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Website analytics (Google Analytics)"}],["$","td",null,{"children":"14 months from collection, then deleted automatically; the cookies themselves expire after 13 months"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Server logs"}],["$","td",null,{"children":"As set by our hosting provider, ordinarily no more than 12 months"}]]}]]}]]}]}]
15:["$","p",null,{"children":"Where a claim is pending or foreseeable, we keep the relevant data until it is finally resolved."}]
16:["$","h2",null,{"children":"8. Your rights"}]
17:["$","p",null,{"children":"Under the GDPR you have the right to:"}]
18:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"access"}]," your data and get a copy of it;"]}],["$","li",null,{"children":["have inaccurate data ",["$","strong",null,{"children":"corrected"}],", and incomplete data completed;"]}],["$","li",null,{"children":["have your data ",["$","strong",null,{"children":"erased"}],", where one of the grounds in Article 17 applies;"]}],["$","li",null,{"children":[["$","strong",null,{"children":"restrict"}]," how we process it, in the situations listed in Article 18;"]}],["$","li",null,{"children":["receive data you gave us in a portable format and have it transmitted to another controller (",["$","strong",null,{"children":"portability"}],"), where processing is based on consent or contract and carried out by automated means;"]}],["$","li",null,{"children":[["$","strong",null,{"children":"object"}]," at any time to processing based on our legitimate interest, and, for direct marketing, to object with no need to give reasons, after which we stop;"]}],["$","li",null,{"children":[["$","strong",null,{"children":"withdraw consent"}]," at any time where processing is based on consent, without affecting the lawfulness of what came before."]}]]}]
