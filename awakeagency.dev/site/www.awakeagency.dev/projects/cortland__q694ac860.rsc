4:["$","li","1",{"className":"CaseGallery-module__TMT3wW__slide","data-slide":1,"data-kind":"text","children":[["$","p",null,{"className":"CaseGallery-module__TMT3wW__slideLabel","children":"Brief"}],false,false,["$","div",null,{"className":"CaseGallery-module__TMT3wW__copy","data-panel":"none","children":[false,["$","div",null,{"className":"CaseGallery-module__TMT3wW__copyGrid","children":[["$","h2",null,{"className":"CaseGallery-module__TMT3wW__copyHeading","children":"A venture that asks senior headhunters to go out on their own."}],["$","div",null,{"className":"CaseGallery-module__TMT3wW__copyBody","children":[[["$","p","0",{"children":"Cortland gives established recruiters what they need to start their own firm: capital, infrastructure, a sales playbook and founders with a stake in the outcome. The people it is talking to already bill well, so the site could not read like a sales pitch."}],["$","p","1",{"children":"We kept the design quiet on purpose. Cream and navy, mountain and mist imagery, a compass mark, and type set in Instrument Sans. The copy makes the argument and the design stays out of its way."}],["$","p","2",{"children":"The Path to Freedom, The Model, Who We Back and About each answer one question a recruiter asks before leaving a salaried seat, and Get in Touch ends every one of them."}]],null]}]]}]]}],false]}]
