4:["$","li","1",{"className":"CaseGallery-module__TMT3wW__slide","data-slide":1,"data-kind":"text","children":[["$","p",null,{"className":"CaseGallery-module__TMT3wW__slideLabel","children":"Brief"}],false,false,["$","div",null,{"className":"CaseGallery-module__TMT3wW__copy","data-panel":"none","children":[false,["$","div",null,{"className":"CaseGallery-module__TMT3wW__copyGrid","children":[["$","h2",null,{"className":"CaseGallery-module__TMT3wW__copyHeading","children":"A WordPress site to move onto Webflow."}],["$","div",null,{"className":"CaseGallery-module__TMT3wW__copyBody","children":[[["$","p","0",{"children":"Manypixels sells design as a subscription, so the site is the product: a large gallery, hundreds of articles, and a marketing team that has to change things without a developer. They came to us to move it off WordPress. Then they stayed."}],["$","p","1",{"children":"The gallery got filtering, a colour tool, and a download that takes one press."}],["$","p","2",{"children":"More than five hundred articles were reorganised so the library could be moved through rather than scrolled. The structure and the content strategy came out of working sessions with their head of marketing."}]],null]}]]}]]}],false]}]
