4:["$","ul",null,{"children":[["$","li","01",{"children":["Research & positioning",". ","Interviews with the team, a sweep of comparable funds, and a hard look at what actually motivates founders and investors to join a network like this one."]}],["$","li","02",{"children":["Visual identity",". ","People-first and open, built from PV's own founder success stories. A simple, recognisable mark; navy for reliability with energising accents; custom icons for support and community."]}],["$","li","03",{"children":["Site on Webflow",". ","Action-oriented paths for founders and for investors, mobile and accessible throughout, with the 2,000+ investor network and real outcomes carrying the argument instead of claims."]}],["$","li","04",{"children":["Decks & guidelines",". ","The investor presentations got the same treatment, plus a short brand guide so the website, the decks and everything after stay one voice."]}]]}]
