a:["$","p",null,{"children":[["$","strong",null,{"children":"Google Analytics"}]," is provided by Google Ireland Limited, acting as our processor under the Google Ads Data Processing Terms. Data may be processed by Google LLC in the United States, which is certified under the EUâ€“U.S. Data Privacy Framework. Analytics data is kept for 14 months and then deleted. See"," ",["$","a",null,{"href":"https://policies.google.com/technologies/partner-sites","target":"_blank","rel":"noreferrer noopener","children":"how Google uses information from sites that use its services"}],"."]}]
